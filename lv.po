#: ../src/cli/abrtcli/cli/retrace.py:47
msgid "Problem already has a backtrace"
msgstr "Problēmai jau ir atpakaļsekojums"

#: ../src/cli/abrtcli/cli/retrace.py:48
msgid "Run abrt retrace with -f/--force to retrace again"
msgstr ""
"Lai veiktu atpakaļtrasēšanu vēlreiz, izpildiet abrt retrace ar -f/--force"

#: ../src/cli/abrtcli/cli/retrace.py:49
msgid "Show backtrace?"
msgstr "Rādīt atpakaļsekojumu?"

#: ../src/cli/abrtcli/cli/retrace.py:52
msgid "No retracing possible for this problem type"
msgstr "Šim problēmas tipam atpakaļtrasēšana nav iespējama"

#: ../src/cli/abrtcli/cli/retrace.py:56
msgid ""
"Upload core dump and perform remote retracing? (It may contain sensitive "
"data). If your answer is 'No', a stack trace will be generated locally. "
"Local retracing requires downloading potentially large amount of debuginfo "
"data"
msgstr ""
"Vai augšupielādēt kodola izmeti un veikt attālu atpakaļtrasēšanu? (Tā var "
"saturēt sensitīvus datus.) Ja atbildēsiet „Nē”, steka trasējums tiks "
"izveidots lokāli. Lokālai atpakaļtrasēšanai jālejupielādē potenciāli liels "
"debuginfo datu apjoms"

#: ../src/cli/abrtcli/cli/retrace.py:71
msgid "Remote retracing"
msgstr "Attāla atpakaļtrasēšana"

#: ../src/cli/abrtcli/cli/retrace.py:74
msgid "Local retracing"
msgstr "Lokāla atpakaļtrasēšana"

#: ../src/cli/abrtcli/cli/status.py:17
msgid "show only the number of problems"
msgstr "rādīt tikai problēmu skaitu"

#: ../src/cli/abrtcli/cli/status.py:19
msgid "only show output if at least one problem is found"
msgstr "rādīt izvadi tikai tad, ja atrasta vismaz viena problēma"

#: ../src/cli/abrtcli/cli/status.py:40
msgid "ABRT has detected a problem. For more information, run “abrt list{}”"
msgstr ""
"ABRT ir konstatējis problēmu. Sīkākai informācijai izpildiet „abrt list{}”"

#: ../src/plugins/analyze_CCpp.xml.in.h:1
msgid ""
"Send core dump to remote retrace server for analysis or perform local "
"analysis if the remote analysis fails"
msgstr ""
"Nosūtīt kodola izmeti analīzei uz attālu atpakaļtrasēšanas serveri vai veikt "
"lokālu analīzi, ja attālā analīze neizdodas"

#: ../src/plugins/analyze_CCpp.xml.in.h:2
msgid ""
"Uploads coredump to a server, which generates backtrace and returns it. If "
"user doesn't want to upload his coredump to anywhere the event performs "
"local analysis. Local analysis is run event if remote analysis fails. Pros: "
"no need for debuginfo downloads. Retrace server's database of debuginfos is "
"more complete. Retrace server may generate better backtraces. Cons: coredump "
"you upload contains all the data from the crashed program, including your "
"private data, if any."
msgstr ""
"Augšupielādē kodola izmeti serverī, kas izveido atpakaļsekojumu un atgriež "
"to. Ja lietotājs nevēlas nekur augšupielādēt savu kodola izmeti, notikums "
"veic lokālu analīzi. Lokālā analīze tiek palaista arī tad, ja attālā analīze "
"neizdodas. Priekšrocības: nav jālejupielādē debuginfo. Atpakaļtrasēšanas "
"servera debuginfo datubāze ir pilnīgāka. Atpakaļtrasēšanas serveris var "
"izveidot labākus atpakaļsekojumus. Trūkumi: augšupielādētā kodola izmete "
"satur visus avarējušās programmas datus, arī jūsu privātos datus, ja tādi ir."

#: ../src/plugins/analyze_VMcore.xml.in.h:1
msgid "Analyze VM core"
msgstr "Analizēt VM kodola izmeti"

#: ../src/plugins/analyze_VMcore.xml.in.h:2
msgid "Install kernel debuginfo packages, generate kernel log and oops message"
msgstr ""
"Instalēt kodola debuginfo pakotnes, izveidot kodola žurnālu un oops ziņojumu"

#: ../src/plugins/analyze_VMcore.xml.in.h:3
msgid ""
"Needs to install kernel debuginfo packages, which might take significant "
"time, and take up disk space."
msgstr ""
"Jāinstalē kodola debuginfo pakotnes, kas var aizņemt ievērojamu laiku un "
"vietu diskā."

#: ../src/plugins/collect_GConf.xml.in.h:1
msgid "Collect GConf configuration"
msgstr "Savākt GConf konfigurāciju"

#: ../src/plugins/collect_GConf.xml.in.h:2
msgid "Save configuration from application's GConf directory"
msgstr "Saglabāt konfigurāciju no lietotnes GConf direktorijas"

#: ../src/plugins/collect_GConf.xml.in.h:3
msgid ""
"Runs gconftool-2 --recursive-list /apps/executable and saves it as "
"'gconf_subtree' element."
msgstr ""
"Izpilda gconftool-2 --recursive-list /apps/executable un saglabā to kā "
"elementu 'gconf_subtree'."

#: ../src/plugins/collect_vimrc_system.xml.in.h:1
msgid "Collect system-wide vim configuration files"
msgstr "Savākt sistēmas vim konfigurācijas failus"

#: ../src/plugins/collect_vimrc_system.xml.in.h:2
msgid "Save /etc/vimrc and /etc/gvimrc"
msgstr "Saglabāt /etc/vimrc un /etc/gvimrc"

#: ../src/plugins/collect_vimrc_system.xml.in.h:3
msgid ""
"Checks if there are vimrc and gvimrc files in /etc and saves them as "
"system_vimrc and system_gvimrc, respectively."
msgstr ""
"Pārbauda, vai direktorijā /etc ir faili vimrc un gvimrc, un saglabā tos "
"attiecīgi kā system_vimrc un system_gvimrc."

#: ../src/plugins/collect_vimrc_user.xml.in.h:1
msgid "Collect yours vim configuration files"
msgstr "Savākt jūsu vim konfigurācijas failus"

#: ../src/plugins/collect_vimrc_user.xml.in.h:2
msgid "Save .vimrc and .gvimrc from your home directory"
msgstr "Saglabāt .vimrc un .gvimrc no jūsu mājas direktorijas"

#: ../src/plugins/collect_vimrc_user.xml.in.h:3
msgid ""
"Checks if there are .vimrc and .gvimrc in your home directory and saves them "
"as user_vimrc and user_gvimrc, respectively."
msgstr ""
"Pārbauda, vai jūsu mājas direktorijā ir .vimrc un .gvimrc, un saglabā tos "
"attiecīgi kā user_vimrc un user_gvimrc."

#: ../src/plugins/post_report.xml.in.h:1
msgid "Post report"
msgstr "Pēc ziņojuma"

#: ../src/plugins/post_report.xml.in.h:2
msgid "Executed after the reporting is finished"
msgstr "Izpilda pēc ziņošanas pabeigšanas"

#: ../src/plugins/post_report.xml.in.h:3
msgid "Used for updating of the databases"
msgstr "Izmanto datubāžu atjaunināšanai"

