#: ../src/cli/cli.c:66
msgid ""
"& [-vsp] -L[PREFIX] [PROBLEM_DIR]\n"
"   or: & [-vspy] -e EVENT PROBLEM_DIR\n"
"   or: & [-vspy] -d PROBLEM_DIR\n"
"   or: & [-vspy] -x PROBLEM_DIR"
msgstr ""
"& [-vsp] -L[PRIEDĒKLIS] [PROBLĒMAS_DIREKTORIJA]\n"
"   vai: & [-vspy] -e NOTIKUMS PROBLĒMAS_DIREKTORIJA\n"
"   vai: & [-vspy] -d PROBLĒMAS_DIREKTORIJA\n"
"   vai: & [-vspy] -x PROBLĒMAS_DIREKTORIJA"

#. short_name long_name  value    parameter_name  help
#: ../src/cli/cli.c:89
msgid "List possible events [which start with PREFIX]"
msgstr "Uzskaitīt iespējamos notikumus [kas sākas ar PRIEDĒKLIS]"

